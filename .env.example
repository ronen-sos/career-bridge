# Database (PostgreSQL — Railway provides this automatically)
DATABASE_URL="postgresql://user:password@localhost:5432/career_bridge?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Public URL (set to your Railway domain in production)
AUTH_URL="http://localhost:3000"

# Google OAuth — from Google Cloud Console
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Job listings — free API keys from https://developer.adzuna.com/signup
ADZUNA_APP_ID="your-adzuna-app-id"
ADZUNA_APP_KEY="your-adzuna-app-key"

# Protects POST /api/jobs/sync for scheduled refreshes (Railway cron, etc.)
CRON_SECRET="replace-with-a-random-secret"
