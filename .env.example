# Database (PostgreSQL — Railway provides this automatically)
DATABASE_URL="postgresql://user:password@localhost:5432/career_bridge?schema=public"
# Optional: cap connections per dev server process (default 5)
# DATABASE_POOL_MAX=5

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Public URL (set to your Railway domain in production)
AUTH_URL="http://localhost:3000"

# Google OAuth — from Google Cloud Console
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Invitation emails — PRODUCTION (Railway): use Resend (HTTPS, not blocked)
# Sign up free at https://resend.com
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Career Bridge <onboarding@yourdomain.com>"

# Invitation emails — LOCAL DEV: Gmail SMTP works on your machine
# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASSWORD="your-16-character-app-password"
# EMAIL_FROM_NAME="Career Bridge"

# Resume generation — Anthropic API (Haiku model)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"
# Optional: override the default model (claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
