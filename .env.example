# Database (PostgreSQL — Railway provides this automatically)
DATABASE_URL="postgresql://user:password@localhost:5432/career_bridge?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Public URL (set to your Railway domain in production)
AUTH_URL="http://localhost:3000"

# Google OAuth — from Google Cloud Console
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Invitation emails — send from your Google account via Gmail SMTP
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"
# Optional display name in the From field (defaults to "Career Bridge")
# EMAIL_FROM_NAME="Career Bridge"
