generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum ActivityType {
  APPLICATION
  NETWORKING
  INTERVIEW
  RESEARCH
  TRAINING
  RESUME
  OTHER
}

enum WeeklyGoalStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
}

enum InterviewApplicationLink {
  LINKED_APPLICATION
  NO_PRIOR_APPLICATION
  RETROACTIVE_APPLICATION
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  logoData     Bytes?
  logoMimeType String?
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String?
  name            String
  image           String?
  role            Role              @default(PARTICIPANT)
  organizationId  String?
  organization    Organization?     @relation(fields: [organizationId], references: [id])
  managerId       String?
  manager         User?             @relation("ManagerParticipants", fields: [managerId], references: [id])
  participants    User[]            @relation("ManagerParticipants")
  activities      JobSearchActivity[]
  weeklyGoals     WeeklyGoal[]      @relation("ParticipantGoals")
  createdWeeklyGoals WeeklyGoal[]   @relation("GoalCreator")
  approvedWeeklyGoals WeeklyGoal[]  @relation("GoalApprover")
  reviewedWeeklyGoals WeeklyGoal[]  @relation("GoalWeekReviewer")
  profile         Profile?
  workExperiences WorkExperience[]
  education       Education[]
  resumeGenerations ResumeGeneration[]
  jobApplications JobApplication[]
  jobInterviews     JobInterview[]
  participantQuestions ParticipantQuestion[] @relation("ParticipantQuestions")
  managedQuestions   ParticipantQuestion[] @relation("ManagedQuestions")
  invitedAt       DateTime?
  lastLoginAt     DateTime?
  welcomeSeenAt   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([organizationId, role])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline  String?
  summary   String?
  phone     String?
  location  String?
  linkedInUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkExperience {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         String
  title           String
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  isCurrent       Boolean   @default(false)
  accomplishments String[]
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, startDate])
}

model Education {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution     String
  degree          String
  fieldOfStudy    String?
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  isCurrent       Boolean   @default(false)
  accomplishments String[]
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, startDate])
}

model CompanyCatalog {
  id             String            @id @default(cuid())
  name           String
  normalizedName String            @unique
  positions      PositionCatalog[]
  applications   JobApplication[]
  interviews     JobInterview[]
  createdAt      DateTime          @default(now())

  @@index([name])
}

model PositionCatalog {
  id                String             @id @default(cuid())
  companyId         String
  company           CompanyCatalog     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title             String
  normalizedTitle   String
  applications      JobApplication[]
  interviews        JobInterview[]
  resumeGenerations ResumeGeneration[]
  createdAt         DateTime           @default(now())

  @@unique([companyId, normalizedTitle])
  @@index([companyId])
}

model JobApplication {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId          String
  company            CompanyCatalog    @relation(fields: [companyId], references: [id])
  positionId         String
  position           PositionCatalog   @relation(fields: [positionId], references: [id])
  resumeGenerationId String?           @unique
  resumeGeneration   ResumeGeneration? @relation(fields: [resumeGenerationId], references: [id], onDelete: SetNull)
  appliedAt          DateTime          @db.Date
  createdAt          DateTime          @default(now())
  interviews         JobInterview[]

  @@index([userId, appliedAt])
  @@index([companyId, positionId])
}

model JobInterview {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String
  company        CompanyCatalog           @relation(fields: [companyId], references: [id])
  positionId     String
  position       PositionCatalog          @relation(fields: [positionId], references: [id])
  applicationId  String?
  application    JobApplication?          @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  interviewedAt  DateTime                 @db.Date
  linkType       InterviewApplicationLink
  notes          String?
  hoursSpent     Float                    @default(0)
  createdAt      DateTime                 @default(now())

  @@index([userId, interviewedAt])
  @@index([companyId, interviewedAt])
  @@index([applicationId])
}

model ResumeGeneration {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole      String?
  targetCompany   String?
  positionId      String?
  position        PositionCatalog?  @relation(fields: [positionId], references: [id], onDelete: SetNull)
  contentMarkdown String            @db.Text
  createdAt       DateTime          @default(now())
  application     JobApplication?
  activity        JobSearchActivity?

  @@index([userId, createdAt])
  @@index([positionId, createdAt])
}

model JobSearchActivity {
  id                   String            @id @default(cuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                 DateTime          @db.Date
  type                 ActivityType
  description          String
  company              String?
  roleTitle            String?
  hoursSpent           Float             @default(0)
  resumeGenerationId   String?           @unique
  resumeGeneration     ResumeGeneration? @relation(fields: [resumeGenerationId], references: [id], onDelete: SetNull)
  managerReviewed      Boolean           @default(false)
  managerNotes         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([userId, date])
}

model WeeklyGoal {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation("ParticipantGoals", fields: [userId], references: [id], onDelete: Cascade)
  weekStart             DateTime         @db.Date
  weekEnd               DateTime         @db.Date
  targetApplications    Int              @default(5)
  targetInterviews      Int              @default(1)
  targetEmploymentHours Float            @default(15)
  notes                 String?
  status                WeeklyGoalStatus @default(DRAFT)
  createdById           String
  createdBy             User             @relation("GoalCreator", fields: [createdById], references: [id])
  managerApprovedAt     DateTime?
  managerApprovedById   String?
  managerApprovedBy     User?            @relation("GoalApprover", fields: [managerApprovedById], references: [id])
  managerApprovalNotes  String?
  weekReviewedAt        DateTime?
  weekReviewedById      String?
  weekReviewedBy        User?            @relation("GoalWeekReviewer", fields: [weekReviewedById], references: [id])
  weekReviewNotes       String?
  customItems           GoalCustomItem[]
  dailyUpdates          GoalDailyUpdate[]
  participantQuestions  ParticipantQuestion[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([userId, weekStart])
  @@index([userId, status])
}

model GoalCustomItem {
  id            String                     @id @default(cuid())
  weeklyGoalId  String
  weeklyGoal    WeeklyGoal                 @relation(fields: [weeklyGoalId], references: [id], onDelete: Cascade)
  label         String
  expectedHours Float                      @default(1)
  sortOrder     Int                        @default(0)
  completions   GoalCustomItemCompletion[]
  createdAt     DateTime                   @default(now())

  @@index([weeklyGoalId, sortOrder])
}

model GoalCustomItemCompletion {
  id            String          @id @default(cuid())
  customItemId  String
  customItem    GoalCustomItem  @relation(fields: [customItemId], references: [id], onDelete: Cascade)
  dailyUpdateId String
  dailyUpdate   GoalDailyUpdate @relation(fields: [dailyUpdateId], references: [id], onDelete: Cascade)
  completed     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([customItemId, dailyUpdateId])
}

model GoalDailyUpdate {
  id                String                     @id @default(cuid())
  weeklyGoalId      String
  weeklyGoal        WeeklyGoal                 @relation(fields: [weeklyGoalId], references: [id], onDelete: Cascade)
  date              DateTime                   @db.Date
  applicationsCount Int                        @default(0)
  interviewsCount   Int                        @default(0)
  employmentHours   Float                      @default(0)
  notes             String
  managerReviewed   Boolean                    @default(false)
  managerReviewedAt DateTime?
  managerNotes      String?
  customCompletions GoalCustomItemCompletion[]
  submittedAt       DateTime                   @default(now())
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([weeklyGoalId, date])
  @@index([weeklyGoalId, date])
}

model ParticipantQuestion {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("ParticipantQuestions", fields: [userId], references: [id], onDelete: Cascade)
  managerId    String
  manager      User        @relation("ManagedQuestions", fields: [managerId], references: [id], onDelete: Cascade)
  weeklyGoalId String?
  weeklyGoal   WeeklyGoal? @relation(fields: [weeklyGoalId], references: [id], onDelete: SetNull)
  question     String
  managerRead  Boolean     @default(false)
  managerReadAt DateTime?
  managerReply String?
  participantReadAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([managerId, managerRead, createdAt])
  @@index([userId, createdAt])
}

model CareerResource {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  content     String?
  url         String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
